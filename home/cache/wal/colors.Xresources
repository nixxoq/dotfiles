! X colors.
! Generated by 'wal'
*foreground:        #bec5c9
*background:        #0a0a0c
*.foreground:       #bec5c9
*.background:       #0a0a0c
emacs*foreground:   #bec5c9
emacs*background:   #0a0a0c
URxvt*foreground:   #bec5c9
XTerm*foreground:   #bec5c9
UXTerm*foreground:  #bec5c9
URxvt*background:   [100]#0a0a0c
XTerm*background:   #0a0a0c
UXTerm*background:  #0a0a0c
URxvt*cursorColor:  #bec5c9
XTerm*cursorColor:  #bec5c9
UXTerm*cursorColor: #bec5c9
URxvt*borderColor:  [100]#0a0a0c

! Colors 0-15.
*.color0: #0a0a0c
*color0:  #0a0a0c
*.color1: #576061
*color1:  #576061
*.color2: #8B755C
*color2:  #8B755C
*.color3: #487089
*color3:  #487089
*.color4: #598EA7
*color4:  #598EA7
*.color5: #70B5CB
*color5:  #70B5CB
*.color6: #7EC0D4
*color6:  #7EC0D4
*.color7: #bec5c9
*color7:  #bec5c9
*.color8: #85898c
*color8:  #85898c
*.color9: #576061
*color9:  #576061
*.color10: #8B755C
*color10:  #8B755C
*.color11: #487089
*color11:  #487089
*.color12: #598EA7
*color12:  #598EA7
*.color13: #70B5CB
*color13:  #70B5CB
*.color14: #7EC0D4
*color14:  #7EC0D4
*.color15: #bec5c9
*color15:  #bec5c9

! Black color that will not be affected by bold highlighting.
*.color66: #0a0a0c
*color66:  #0a0a0c

! Xclock colors.
XClock*foreground: #bec5c9
XClock*background: #0a0a0c
XClock*majorColor:  rgba:be/c5/c9/ff
XClock*minorColor:  rgba:be/c5/c9/ff
XClock*hourColor:   rgba:be/c5/c9/ff
XClock*minuteColor: rgba:be/c5/c9/ff
XClock*secondColor: rgba:be/c5/c9/ff

! Set depth to make transparency work.
URxvt*depth: 32
