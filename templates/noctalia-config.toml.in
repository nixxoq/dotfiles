enable_notification_sounds = true
enable_overdrive = false
enable_power_sounds = true
enable_screenshot_sounds = true
enable_sounds = false
enable_volume_sounds = true
sound_theme = "freedesktop"
sound_volume = 0.5
spectrum_frame_rate = 60

[backdrop]
blur_intensity = 0.34999999403953552
enabled = true
tint_intensity = 0.30000001192092896

[bar]
order = [ "default" ]

    [bar.default]
    auto_hide = false
    auto_hide_delay_ms = 0
    auto_hide_reserve_space = false
    background_opacity = 0.55000001192092896
    border = "outline_variant"
    border_width = 0.0
    capsule = false
    capsule_border_width = 1.0
    capsule_fill = "#101418"
    capsule_group = []
    capsule_opacity = 0.34999999403953552
    capsule_padding = 4.0
    capsule_thickness = 0.75999999046325684
    center = [ "media", "clock" ]
    compositor_blur = true
    concave_edge_corners = true
    contact_shadow = false
    enabled = true
    end = [
        "network",
        "toggle",
        # if {BATTERY}
        "battery",
        "battery-graph-widget",
        # {BATTERY}
        "bluetooth",
        "volume",
        "brightness",
        "spacer_3",
        "tray",
        "spacer_4",
        "keyboard_layout",
        "notifications"
    ]
    font_scale = 1.0
    font_weight = 500
    hover_highlight = true
    layer = "top"
    margin_edge = 5
    margin_ends = 280
    margin_opposite_edge = 0
    padding = 14
    panel_overlap = 1
    position = "top"
    radius = 12
    radius_bottom_left = 12
    radius_bottom_right = 12
    radius_top_left = 12
    radius_top_right = 12
    reserve_space = true
    scale = 1.0
    shadow = true
    show_on_workspace_switch = true
    show_tooltip = true
    smart_auto_hide = false
    start = [ "control-center", "workspaces", "wallpaper", "spacer_7", "cpu", "cat_2", "summary" ]
    thickness = 21
    widget_spacing = 6

        [bar.default.dead_zone]
        click_through = false

[battery]
warning_threshold = 25

[bluetooth]
connect_when_enabled = false
connection_notifications = false

[brightness]
