show_scroll_lock = false
type = "lock_keys"

[widget.media]
art_size = 16.0
max_length = 220.0
min_length = 80.0
title_scroll = "none"
type = "media"

[widget.network_rx]
stat = "net_rx"
type = "sysmon"

[widget.network_tx]
stat = "net_tx"
type = "sysmon"

[widget.output_volume]
device = "output"
type = "volume"

[widget.ram]
stat = "ram_used"
type = "sysmon"

[widget.spacer]
interactive = false
type = "spacer"

[widget.spacer_2]
length = 25
type = "spacer"

[widget.spacer_3]
length = 15
type = "spacer"

[widget.spacer_4]
length = 15
type = "spacer"

[widget.spacer_5]
type = "spacer"

[widget.spacer_6]
type = "spacer"

[widget.spacer_7]
type = "spacer"

[widget.spacer_8]
type = "spacer"

[widget.summary]
type = "gustav0ar/drive-health:summary"

[widget.temp]
stat = "cpu_temp"
type = "sysmon"

[widget.toggle]
type = "cleboost/hotspot:toggle"
