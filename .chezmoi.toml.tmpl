{{- $chaotic := promptBoolOnce . "use_chaotic_aur" "Install Chaotic-AUR repository?" true -}}
{{- $nvidia := promptBoolOnce . "use_nvidia_beta" "Install NVIDIA beta drivers?" false -}}
{{- $gaming := promptBoolOnce . "install_gaming" "Install gaming tools?" true -}}
{{- $zen := promptBoolOnce . "install_zen" "Install Zen Browser?" true -}}
{{- $optionalPkgs := promptBoolOnce . "install_optional_packages" "Install optional package tier?" true -}}
{{- $manageSystemFontconfig := promptBoolOnce . "manage_system_fontconfig" "Manage /etc/fonts/conf.d Apple Emoji symlink? (requires sudo)" false -}}
{{- $gitName := promptStringOnce . "git_name" "Git user.name" "NixxO" -}}
{{- $gitEmail := promptStringOnce . "git_email" "Git email" "" -}}
{{- $gitSigningKey := promptStringOnce . "git_signingkey" "Git GPG signing key (empty to skip)" "" -}}
{{- $githubFeedUsername := promptStringOnce . "github_feed_username" "Noctalia GitHub feed username (empty to skip)" "" -}}
{{- $githubFeedToken := promptStringOnce . "github_feed_token" "Noctalia GitHub feed token (empty to skip)" "" -}}
{{- $wallpaperDir := promptStringOnce . "wallpaper_dir" "Wallpaper directory" (printf "%s/Pictures/Wallpapers" .chezmoi.homeDir) -}}
{{- $lmstudioPath := promptStringOnce . "lmstudio_path" "LM Studio bin path (empty to skip)" (printf "%s/.lmstudio/bin" .chezmoi.homeDir) -}}
{{- $jetbrainsToolboxPath := promptStringOnce . "jetbrains_toolbox_path" "JetBrains Toolbox scripts path (empty to skip)" (printf "%s/.local/share/JetBrains/Toolbox/scripts" .chezmoi.homeDir) -}}

[data]
    use_chaotic_aur = {{ $chaotic }}
    use_nvidia_beta = {{ $nvidia }}
    install_gaming = {{ $gaming }}
    install_zen = {{ $zen }}
    install_optional_packages = {{ $optionalPkgs }}
    manage_system_fontconfig = {{ $manageSystemFontconfig }}
    git_name = {{ $gitName | quote }}
    git_email = {{ $gitEmail | quote }}
    git_signingkey = {{ $gitSigningKey | quote }}
    github_feed_username = {{ $githubFeedUsername | quote }}
    github_feed_token = {{ $githubFeedToken | quote }}
    wallpaper_dir = {{ $wallpaperDir | quote }}
    lmstudio_path = {{ $lmstudioPath | quote }}
    jetbrains_toolbox_path = {{ $jetbrainsToolboxPath | quote }}
