{{- $chaotic := promptBoolOnce . "use_chaotic_aur" "Install Chaotic-AUR repository?" true -}}
{{- $sddm := promptBoolOnce . "install_sddm" "Install and enable SDDM?" true -}}
{{- $vscode := promptBoolOnce . "install_vscode" "Install Visual Studio Code? (With custom settings)" true -}}
{{- $optionalPkgs := promptBoolOnce . "install_optional_packages" "Install optional package tier?" true -}}
{{- $manageSystemFontconfig := promptBoolOnce . "manage_system_fontconfig" "Manage /etc/fonts/conf.d Apple Emoji symlink? (requires sudo)" false -}}
{{- $discordHook := promptBoolOnce . "install_discord_hook" "Install and enable Equicord patch pacman hook? (requires sudo)" false -}}
{{- $gitName := promptStringOnce . "git_name" "Git user.name" .chezmoi.username -}}
{{- $gitEmail := promptStringOnce . "git_email" "Git email" "" -}}
{{- $gitSigningKey := promptStringOnce . "git_signingkey" "Git GPG signing key (empty to skip)" "" -}}
{{- $githubFeedUsername := promptStringOnce . "github_feed_username" "Noctalia GitHub feed username (empty to skip)" "" -}}
{{- $githubFeedToken := promptStringOnce . "github_feed_token" "Noctalia GitHub feed token (empty to skip)" "" -}}
{{- $wallpaperDir := promptStringOnce . "wallpaper_dir" "Wallpaper directory" (printf "%s/Pictures/Wallpapers" .chezmoi.homeDir) -}}

{{- $keyboardLayout := promptStringOnce . "keyboard_layout" "Keyboard layouts (comma-separated, e.g. us,ua,ru)" "us" -}}
{{- $layoutSwitchers := dict "Alt + Shift" "grp:alt_shift_toggle" "Win + Space" "grp:win_space_toggle" "Ctrl + Shift" "grp:ctrl_shift_toggle" "Caps Lock" "grp:caps_toggle" "Custom" "custom" -}}
{{- $switcherKey := promptChoiceOnce . "keyboard_switcher" "Select layout switching shortcut" (keys $layoutSwitchers) "Alt + Shift" -}}
{{- $selectedSwitcher := get $layoutSwitchers $switcherKey -}}

{{- if eq $selectedSwitcher "custom" -}}
    {{- $selectedSwitcher = promptStringOnce . "keyboard_options_custom" "Enter custom XKB options" "grp:alt_shift_toggle" -}}
{{- end -}}

{{- $hasBattery := false -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $batteryCheck := output "sh" "-c" "if ls /sys/class/power_supply/BAT* >/dev/null 2>&1; then echo 'true'; else echo 'false'; fi" | trim -}}
  {{- if eq $batteryCheck "true" -}}
    {{- $hasBattery = true -}}
  {{- end -}}
{{- end -}}

{{- $monitorOutput := "eDP-1" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $detectedMonitor := output "sh" "-c" "for d in /sys/class/drm/card*-*; do if [ -f $d/status ] && [ \"$(cat $d/status)\" = 'connected' ]; then echo ${d#/sys/class/drm/card*-}; break; fi; done" | trim -}}
  {{- if $detectedMonitor -}}
    {{- $monitorOutput = $detectedMonitor -}}
  {{- end -}}
{{- end -}}

{{- $keyboardDevice := "" -}}
{{- if eq .chezmoi.os "linux" -}}
  {{- $detectedKeyboard := output "sh" "-c" `
    stable_kbs=$(find /dev/input/by-id/ /dev/input/by-path/ -name "*event-kbd" 2>/dev/null)
    kb_dev=$(echo "$stable_kbs" | grep "/by-id/" | grep -vi "mouse" | head -n1)
    if [ -z "$kb_dev" ]; then
      kb_dev=$(echo "$stable_kbs" | grep "/by-id/" | head -n1)
    fi
    if [ -z "$kb_dev" ]; then
      kb_dev=$(echo "$stable_kbs" | grep "/by-path/" | head -n1)
    fi
    echo "$kb_dev"
  ` | trim -}}
  {{- if $detectedKeyboard -}}
    {{- $keyboardDevice = $detectedKeyboard -}}
  {{- end -}}
{{- end -}}

[data]
    use_chaotic_aur = {{ $chaotic }}
    install_sddm = {{ $sddm }}
    install_vscode = {{ $vscode }}
    install_optional_packages = {{ $optionalPkgs }}
    manage_system_fontconfig = {{ $manageSystemFontconfig }}
    install_discord_hook = {{ $discordHook }}
    git_name = {{ $gitName | quote }}
    git_email = {{ $gitEmail | quote }}
    git_signingkey = {{ $gitSigningKey | quote }}
    github_feed_username = {{ $githubFeedUsername | quote }}
    github_feed_token = {{ $githubFeedToken | quote }}
    wallpaper_dir = {{ $wallpaperDir | quote }}
    keyboard_layout = {{ $keyboardLayout | quote }}
    keyboard_options = {{ $selectedSwitcher | quote }}

    has_battery = {{ $hasBattery }}
    monitor_output = {{ $monitorOutput | quote }}
    keyboard_device = {{ $keyboardDevice | quote }}
